[Unit]
Description=PiWeather — weather display for Waveshare 1.54" ST7789 LCD
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piweather
Group=piweather
WorkingDirectory=/opt/piweather
ExecStart=/opt/piweather/.venv/bin/python /opt/piweather/src/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piweather
Environment=PIWEATHER_CONFIG=/etc/piweather/config.json

[Install]
WantedBy=multi-user.target
